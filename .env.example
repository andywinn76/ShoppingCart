# ----------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# Never commit .env.local. Each section explains where to find the values.
# ----------------------------------------------------------------------------

# ----- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=My Shop
NEXT_PUBLIC_STORE_TAGLINE=Curated goods, delivered.

# Shipping (in cents). 700 = $7.00 flat; orders >= FREE_THRESHOLD ship free.
SHIPPING_FLAT_RATE_CENTS=700
SHIPPING_FREE_THRESHOLD_CENTS=5000

# ----- Supabase -------------------------------------------------------------
# https://app.supabase.com -> Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ----- NextAuth -------------------------------------------------------------
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Optional social providers (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Stripe ---------------------------------------------------------------
# https://dashboard.stripe.com/apikeys (use TEST keys during development)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# After running `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# copy the whsec_... value here.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Enable Stripe Tax in your Stripe dashboard; nothing extra needed here.

# ----- Cloudinary -----------------------------------------------------------
# https://console.cloudinary.com -> Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Create an unsigned upload preset in Cloudinary settings -> Upload
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=my_shop_unsigned

# ----- Resend (transactional email) ----------------------------------------
# https://resend.com -> API Keys
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=orders@yourdomain.com
